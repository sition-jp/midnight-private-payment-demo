pragma language_version >= 0.16 && <= 0.21;

import CompactStandardLibrary;

// =============================================================================
// Private Payment Contract (compactc 0.29.0 / compact-runtime 0.14.0)
// =============================================================================
// - Amount and recipient are private (witness) — never disclosed on-chain
// - Only balance commitments (hashes) are stored on the ledger
// - ZKP proves: sender knows balance, balance >= amount, commitments are valid
// =============================================================================

// === Ledger: public_key -> balance commitment (hash of balance + salt) ===
export ledger balance_commitments: Map<Bytes<32>, Bytes<32>>;

// === Witnesses (private off-chain inputs) ===
witness local_secret_key(): Bytes<32>;
witness private_amount(): Uint<64>;
witness private_recipient(): Bytes<32>;
witness get_balance(pk: Bytes<32>): Uint<64>;
witness get_salt(pk: Bytes<32>): Bytes<32>;
witness new_salt(): Bytes<32>;
witness store_balance(pk: Bytes<32>, balance: Uint<64>, salt: Bytes<32>): [];
witness get_recipient_balance(): Uint<64>;
witness get_recipient_salt(): Bytes<32>;
witness new_recipient_salt(): Bytes<32>;
witness store_recipient_balance(pk: Bytes<32>, balance: Uint<64>, salt: Bytes<32>): [];

// === Helper: derive public key from secret key ===
pure circuit derive_pk(sk: Bytes<32>): Bytes<32> {
  return persistentHash<Vector<2, Bytes<32>>>([
    pad(32, "midnight:pk:"),
    sk
  ]);
}

// === Helper: compute balance commitment ===
pure circuit compute_commitment(
  pk: Bytes<32>,
  balance: Uint<64>,
  salt: Bytes<32>
): Bytes<32> {
  const balance_bytes = (balance as Field) as Bytes<32>;
  return persistentHash<Vector<3, Bytes<32>>>([pk, balance_bytes, salt]);
}

// === Circuit: Deposit (public amount) ===
export circuit deposit(amount: Uint<64>): [] {
  const sk = local_secret_key();
  const pk = derive_pk(sk);

  assert(disclose(amount > 0), "Deposit amount must be positive");

  const current_balance = get_balance(pk);
  const current_salt = get_salt(pk);

  if (disclose(balance_commitments.member(disclose(pk)))) {
    const expected = compute_commitment(pk, current_balance, current_salt);
    const stored = balance_commitments.lookup(disclose(pk));
    assert(expected == stored, "Balance commitment mismatch");
  }

  const new_balance = (current_balance + amount) as Uint<64>;
  const salt = new_salt();
  const new_commit = compute_commitment(pk, new_balance, salt);

  balance_commitments.insert(disclose(pk), disclose(new_commit));
  store_balance(pk, new_balance, salt);
}

// === Circuit: Private Transfer ===
// amount (witness) and recipient (witness) are never disclosed on-chain.
// ZKP proves: (1) sender balance matches commitment, (2) balance >= amount,
// (3) new commitments are correctly derived.
export circuit private_transfer(): [] {
  const sk = local_secret_key();
  const sender_pk = derive_pk(sk);
  const amount = private_amount();
  const recipient_pk = private_recipient();

  assert(amount > 0, "Transfer amount must be positive");

  // Verify sender's current balance commitment
  const sender_balance = get_balance(sender_pk);
  const sender_salt = get_salt(sender_pk);
  const sender_commit = compute_commitment(sender_pk, sender_balance, sender_salt);
  const stored_sender = balance_commitments.lookup(disclose(sender_pk));
  assert(sender_commit == stored_sender, "Sender balance commitment mismatch");

  // ZKP: prove sufficient balance (never disclosed)
  assert(sender_balance >= amount, "Insufficient balance");

  // New sender commitment
  const new_sender_balance = (sender_balance - amount) as Uint<64>;
  const sender_new_salt = new_salt();
  const new_sender_commit = compute_commitment(
    sender_pk, new_sender_balance, sender_new_salt
  );

  // Recipient side
  const recipient_balance = get_recipient_balance();
  const recipient_salt = get_recipient_salt();

  if (disclose(balance_commitments.member(disclose(recipient_pk)))) {
    const recipient_commit = compute_commitment(
      recipient_pk, recipient_balance, recipient_salt
    );
    const stored_recipient = balance_commitments.lookup(disclose(recipient_pk));
    assert(recipient_commit == stored_recipient, "Recipient balance commitment mismatch");
  }

  // New recipient commitment
  const new_recipient_balance = (recipient_balance + amount) as Uint<64>;
  const recipient_new_salt = new_recipient_salt();
  const new_recipient_commit = compute_commitment(
    recipient_pk, new_recipient_balance, recipient_new_salt
  );

  // Update on-chain commitments only (no amounts or identities revealed)
  balance_commitments.insert(disclose(sender_pk), disclose(new_sender_commit));
  balance_commitments.insert(disclose(recipient_pk), disclose(new_recipient_commit));

  // Store actual balances off-chain
  store_balance(sender_pk, new_sender_balance, sender_new_salt);
  store_recipient_balance(recipient_pk, new_recipient_balance, recipient_new_salt);
}

// === Circuit: Check Own Balance ===
export circuit check_balance(): Uint<64> {
  const sk = local_secret_key();
  const pk = derive_pk(sk);
  const balance = get_balance(pk);
  const salt = get_salt(pk);

  if (disclose(balance_commitments.member(disclose(pk)))) {
    const expected = compute_commitment(pk, balance, salt);
    const stored = balance_commitments.lookup(disclose(pk));
    assert(expected == stored, "Balance commitment mismatch");
  }

  return disclose(balance);
}

{
  "name": "deploy-test",
  "version": "1.0.0",
  "type": "module",
  "description": "A Midnight Network application created with create-mn-app",
  "author": "",
  "license": "MIT",
  "scripts": {
    "compile:private": "compact compile +0.31.1 ../contracts/private-payment/private_payment.compact contracts/managed/private-payment",
    "prebuild": "npm run compile:private",
    "build": "tsc --noEmit",
    "setup": "docker compose up -d && npm run deploy",
    "predeploy": "npm run compile:private",
    "deploy": "npx tsx src/deploy.ts",
    "preconnect-test": "npm run compile:private",
    "connect-test": "npx tsx src/connect-test.ts",
    "predeposit-test": "npm run compile:private",
    "deposit-test": "npx tsx src/deposit-test.ts",
    "pretransfer-test": "npm run compile:private",
    "transfer-test": "npx tsx src/transfer-test.ts",
    "prefull-test": "npm run compile:private",
    "full-test": "npx tsx src/full-test.ts",
    "precli": "npm run compile:private",
    "cli": "npx tsx src/cli.ts",
    "precheck-balance": "npm run compile:private",
    "check-balance": "npx tsx src/check-balance.ts",
    "proof-server:start": "docker compose up -d",
    "proof-server:stop": "docker compose down",
    "clean": "rm -rf contracts/managed deployment.json",
    "pretest": "npm run compile:private",
    "test": "npm run test:unit && npm run test:disclosure",
    "test:unit": "node --import tsx --test src/runtime-files.test.ts",
    "test:disclosure": "node --import tsx --test src/private-payment-disclosure.test.ts"
  },
  "dependencies": {
    "@midnight-ntwrk/compact-js": "2.5.1",
    "@midnight-ntwrk/compact-runtime": "0.16.0",
    "@midnight-ntwrk/ledger-v8": "8.1.0",
    "@midnight-ntwrk/midnight-js-contracts": "4.1.1",
    "@midnight-ntwrk/midnight-js-http-client-proof-provider": "4.1.1",
    "@midnight-ntwrk/midnight-js-indexer-public-data-provider": "4.1.1",
    "@midnight-ntwrk/midnight-js-level-private-state-provider": "4.1.1",
    "@midnight-ntwrk/midnight-js-network-id": "4.1.1",
    "@midnight-ntwrk/midnight-js-node-zk-config-provider": "4.1.1",
    "@midnight-ntwrk/midnight-js-protocol": "4.1.1",
    "@midnight-ntwrk/midnight-js-types": "4.1.1",
    "@midnight-ntwrk/midnight-js-utils": "4.1.1",
    "@midnight-ntwrk/wallet-sdk-abstractions": "2.1.0",
    "@midnight-ntwrk/wallet-sdk-dust-wallet": "4.1.0",
    "@midnight-ntwrk/wallet-sdk-facade": "4.0.1",
    "@midnight-ntwrk/wallet-sdk-hd": "3.0.2",
    "@midnight-ntwrk/wallet-sdk-shielded": "3.0.1",
    "@midnight-ntwrk/wallet-sdk-unshielded-wallet": "3.1.0",
    "rxjs": "7.8.2",
    "ws": "8.21.1"
  },
  "devDependencies": {
    "@types/node": "24.12.0",
    "@types/ws": "8.18.1",
    "tsx": "4.21.0",
    "typescript": "5.9.3"
  },
  "engines": {
    "node": ">=22.0.0"
  },
  "keywords": ["midnight", "blockchain", "zero-knowledge", "privacy"]
}
